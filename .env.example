# ---------- DISCORD ----------
BOT_NOME=ACE
DISCORD_TOKEN=coloque_o_token_do_bot_aqui
CLIENT_ID=id_da_aplicacao_do_bot
GUILD_ID=id_do_seu_servidor

# ---------- BOT CRIADOR DE SALAS (opcional) ----------
# Token de uma conta de usuario comum do Discord (NAO e token de aplicacao Bot).
# Quando preenchido, o bot manda "+cs 1/2/3" no ticket assim que a partida entra em
# AGUARDANDO CRIACAO DA SALA. Deixe vazio para manter esse recurso desligado.
# Atencao: automatizar uma conta de usuario viola os Termos de Servico do Discord
# e pode banir a conta usada. Uso por conta e risco de quem configurar o token.
SALA_BOT_TOKEN=

# ---------- IA CHAT (OPENAI) ----------
# Crie uma chave de projeto em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
# Modelo economico para chat de alto volume. Pode ser trocado sem alterar o codigo.
OPENAI_MODEL=gpt-5.6-luna
# Limite de resposta por mensagem da IA.
IA_MAX_OUTPUT_TOKENS=500

# ---------- MERCADO PAGO ----------
# Painel: https://www.mercadopago.com.br/developers/panel/app -> Credenciais de producao
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# URL publica que o Mercado Pago vai chamar quando o PIX for pago.
# Local (teste): use ngrok -> https://xxxx.ngrok-free.app
# VPS: https://seudominio.com
PUBLIC_URL=https://xxxx.ngrok-free.app
WEBHOOK_PORT=3000

# ---------- REGRAS DE NEGOCIO ----------
# Taxa da organizacao por partida, em centavos (50 = R$0,50 -> R$0,25 de cada lado)
TAXA_PARTIDA_CENTAVOS=50
DEPOSITO_MINIMO_CENTAVOS=100
SAQUE_MINIMO_CENTAVOS=500
# Minutos que o PIX fica valido
PIX_EXPIRA_MINUTOS=30
# Prazo para quem entrou na fila sem saldo pagar a partida no ticket
PAGAMENTO_PARTIDA_MINUTOS=15

# ---------- ROLLOVER (ANTI-LAVAGEM) ----------
# Percentual do que entrou (deposito + bonus) que precisa ser jogado antes de sacar
ROLLOVER_PERCENTUAL=80
# Minimo de partidas validas e de adversarios distintos desde o ultimo saque
ROLLOVER_MIN_APOSTAS=3
ROLLOVER_MIN_ADVERSARIOS=2

# ---------- CONFIRMACAO DE RESULTADO ----------
# Minutos ate o bot validar sozinho a unica escolha registrada
CONFIRMACAO_MINUTOS=20
# Pontos de elo perdidos por quem nao confirmou o resultado
PENALIDADE_NAO_CONFIRMAR=15

# ---------- PONTOS / ELO ----------
# Pontos ganhos ao vencer e perdidos ao perder (nunca fica negativo)
PONTOS_VITORIA=25
PONTOS_DERROTA=12

# ---------- MODO TESTE ----------
# true = nao chama o Mercado Pago, gera PIX falso aprovado automaticamente.
# Use para testar tudo no PC sem gateway. Em producao deixe false.
FAKE_PAYMENTS=false
